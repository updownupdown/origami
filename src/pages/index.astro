---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../lib/categories';
import { icon } from '../lib/icons';
import index from '../generated/index.json';
const base = import.meta.env.BASE_URL;
const foldable = index.filter((e: any) => e.kind === 'foldable');
const linkCount = index.length - foldable.length;
---
<Base title="Origami">
  <div class="browse">
    <header class="top">
      <a class="logo" href={base} aria-label="Origami home">
        <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><polygon points="2,16 16,2 16,30" fill="currentColor"></polygon><polygon points="16,2 30,16 16,30" fill="var(--accent)"></polygon></svg>
        <span>Origami</span>
      </a>
      <label class="search">
        <Fragment set:html={icon('search')} />
        <span class="visually-hidden">Search models</span>
        <input id="q" type="search" placeholder={`Search ${foldable.length} models`} autocomplete="off" />
      </label>
      <nav class="links">
        <a href={`${base}author/`}>Author</a>
        <a href={`${base}about/`}>About</a>
      </nav>
    </header>

    <div class="filters" role="group" aria-label="Filters">
      <div class="cats" id="cats">
        <button class="btn small" aria-pressed="true" data-cat="">All</button>
        {CATEGORIES.map((c) => <button class="btn small" aria-pressed="false" data-cat={c.id}>{c.label}</button>)}
      </div>
      <div class="selects">
        <label>
          <span class="visually-hidden">Difficulty</span>
          <select id="difficulty">
            <option value="">Any level</option>
            <option value="1">Beginner</option>
            <option value="2">Easy</option>
            <option value="3">Intermediate</option>
            <option value="4">Advanced</option>
            <option value="5">Complex</option>
          </select>
        </label>
        <label>
          <span class="visually-hidden">Sheets</span>
          <select id="sheets">
            <option value="">Any sheets</option>
            <option value="1">Single sheet</option>
            <option value="2">Multiple sheets</option>
          </select>
        </label>
        <label class="toggle" title="Models listed elsewhere that we haven't written steps for yet">
          <input type="checkbox" id="links" />
          <span>Show link-only{linkCount ? ` (${linkCount})` : ''}</span>
        </label>
      </div>
    </div>

    <p class="status" id="status" aria-live="polite"></p>
    <ul class="grid" id="grid">
      {foldable.map((e: any) => (
        <li><a class="tile" href={`${base}models/${e.id}/`}><span class="thumb"><img src={`${base}thumbs/${e.id}.svg`} alt="" loading="lazy" /></span><span class="name">{e.title}</span></a></li>
      ))}
    </ul>
  </div>
</Base>

<style is:global>
  .browse { max-width: 1240px; margin: 0 auto; padding: 20px 16px 64px; display: flex; flex-direction: column; gap: 16px; }
  .top { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-size: 22px; font-weight: 600; color: var(--ink); }
  .search { flex: 1 1 280px; display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 16px; border-radius: 23px; background: var(--paper-raised); border: 1px solid var(--line); color: var(--ink-soft); }
  .search input { flex: 1; border: none; background: transparent; outline: none; font-size: 16px; color: var(--ink); min-width: 0; }
  .links { display: flex; gap: 16px; font-size: 15px; }
  .links a { color: var(--ink-soft); text-decoration: none; }
  .links a:hover { color: var(--ink); }
  .filters { display: flex; flex-direction: column; gap: 10px; }
  .cats { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
  .selects { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .selects select { height: 36px; border-radius: 18px; border: 1px solid var(--line-strong); background: var(--paper-raised); padding: 0 12px; }
  .toggle { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-soft); cursor: pointer; }
  .toggle input { width: 18px; height: 18px; accent-color: var(--ink); }
  .status { margin: 0; font-size: 14px; color: var(--ink-soft); min-height: 20px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; }
  .tile { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--ink); background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform 0.15s, box-shadow 0.15s; }
  .tile:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .tile .thumb { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: var(--paper-sunk); position: relative; }
  .tile .thumb img { width: 100%; height: 100%; object-fit: contain; }
  .tile .badge { position: absolute; top: 8px; left: 8px; }
  .tile .done { position: absolute; top: 8px; right: 8px; width: 26px; height: 26px; border-radius: 13px; background: var(--ink); color: var(--paper-raised); display: flex; align-items: center; justify-content: center; }
  .tile .done svg { width: 16px; height: 16px; }
  .tile .meta { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 3px; }
  .tile .name { font-size: 15px; font-weight: 500; line-height: 1.25; }
  .tile .sub { font-size: 12px; color: var(--ink-soft); display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .tile.link .thumb { background: repeating-linear-gradient(135deg, var(--paper-sunk) 0 10px, var(--paper) 10px 20px); }
  .tile.link .thumb .glyph { font-size: 44px; font-weight: 300; color: var(--ink-faint); }
  @media (max-width: 520px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .links { display: none; } }
</style>

<script>
  import { initBrowse } from '../scripts/browse';
  initBrowse();
</script>
